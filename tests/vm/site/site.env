# Site for the local QEMU test VM only (user-mode networking). All addresses are QEMU's user-mode defaults.
ADMIN_USER=admin
AUTHORIZED_KEYS_FILE=authorized_keys
LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us
UPDATES=security
TIMEZONE=Etc/UTC
APT_FALLBACK=offline-install
INSTALLER_NETWORK_FILE=installer-network.yaml
NETPLAN_FILE=netplan.yaml
NETPLAN_FILE_NAME=10-vm.yaml
WAIT_ONLINE_INTERFACES=enp0s3
LAN_CIDR=10.0.2.0/24
POD_CIDR=198.18.0.0/16
KUBE_VERSION=1.36.3
KUBE_MINOR=v1.36
PAUSE_IMAGE=registry.k8s.io/pause:3.10.2
EXPECT_INTERFACES=enp0s3
ETCD_SIZE=1G
LONGHORN_SIZE=2G
