# Example site for node-provisioning. All addresses are documentation ranges (RFC 5737 / RFC 2544).
# Copy this directory somewhere private, edit it, and keep it out of this repository.
# Paths are relative to this directory. Values are literal: no quotes, no variables.
ADMIN_USER=admin
AUTHORIZED_KEYS_FILE=authorized_keys.example
LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us
KEYBOARD_VARIANT=
UPDATES=security
TIMEZONE=Etc/UTC
# abort (default): fail loudly if no mirror is reachable. offline-install continues with the ISO's packages.
APT_FALLBACK=abort
INSTALLER_NETWORK_FILE=installer-network.yaml
NETPLAN_FILE=netplan.yaml
NETPLAN_FILE_NAME=10-site.yaml
WAIT_ONLINE_INTERFACES=bond0.100

# node-setup
LAN_CIDR=192.0.2.0/24
POD_CIDR=198.18.0.0/16
KUBE_VERSION=1.36.3
KUBE_MINOR=v1.36
PAUSE_IMAGE=registry.k8s.io/pause:3.10.2
EXPECT_INTERFACES=enp1s0,enp2s0
EXPECT_BONDS=bond0
