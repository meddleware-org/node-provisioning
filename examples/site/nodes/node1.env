HOSTNAME=node1
NODE_IP=192.0.2.10
# Disks are identified by udev ID_SERIAL (no device names, no defaults). Find them on the target with:
#   udevadm info --query=property --name=/dev/<disk> | grep '^ID_SERIAL='
OS_DISK_SERIAL=ExampleVendor_OsDisk_EX0000000001
DATA_DISK_SERIAL=ExampleVendor_DataDisk_EX0000000002
# Secrets are files outside this directory, mode 0600. Default location:
#   ~/.config/node-provisioning/<site-directory-name>/<node>/password-hash
# Override with a path relative to this directory or absolute:
# PASSWORD_HASH_FILE=/path/to/password-hash
